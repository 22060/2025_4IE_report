drop table if exists Products;
create table Products (
    id integer primary key,
    name varchar(100),
    unit_value integer,
    unit varchar(5),
    material varchar(300),
    price integer
);

drop table if exists Materials;
create table Materials (
    id integer primary key,
    name varchar(100),
    unit_value integer,
    unit_amount integer,
    unit varchar(5),
    price integer
);

