drop table if exists account;
create table account(
    id varchar(20) primary key,
    hashed varchar(70),
    salt varchar(10)
);

drop table if exists filesdata;
create table filesdata(
    id integer primary key,
    userid varchar(20),
    filename varchar(150),
    uploadate integer
);

